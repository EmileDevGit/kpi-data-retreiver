// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// stopped: user-initiated, no polling.
// active: polling normally at pollIntervalMs.
// error: scheduler-initiated after consecutiveFailureCount hits the failure
// threshold — keeps polling at a slower fixed retry cadence and returns to
// active automatically on the next successful poll.
enum PollingStatus {
  active
  stopped
  error

  @@map("polling_status")
}

model Site {
  id        String   @id @default(uuid()) @map("site_id")
  name      String   @unique @map("site_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  machines Machine[]

  @@map("sites")
}

model Machine {
  id        String   @id @default(uuid()) @map("machine_id")
  siteId    String   @map("site_id")
  name      String   @unique @map("machine_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id])
  devices Device[]

  @@index([siteId])
  @@map("machines")
}

model Device {
  id           String   @id @default(uuid()) @map("device_id")
  machineId    String   @map("machine_id")
  macAddress   String   @unique @map("mac_address")
  ipAddress    String   @unique @map("ip_address")
  username     String
  passwordEncrypted String @map("password_encrypted")
  description  String?
  pollIntervalMs  Int     @default(60000) @map("poll_interval_ms")
  pollingStatus   PollingStatus @default(stopped) @map("polling_status")
  consecutiveFailureCount Int   @default(0) @map("consecutive_failure_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  machine Machine @relation(fields: [machineId], references: [id])
  channelConfigs ChannelConfig[]
  polls DevicePoll[]
  messageLogs MessageLog[]

  @@index([machineId])
  @@map("devices")
}

model ChannelConfig {
  deviceId          String  @map("device_id")
  channelNumber     Int     @map("channel_number")
  mode              Int
  signalLogicStatus Int     @map("signal_logic_status")
  isPaused          Boolean @default(false) @map("is_paused")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, channelNumber])
  @@map("channel_configs")
}

model DevicePoll {
  id           String   @id @default(uuid()) @map("poll_id")
  deviceId     String   @map("device_id")
  fetchedAt    DateTime @default(now()) @map("fetched_at")
  isSuccessful Boolean  @map("is_successful")
  error        String?  @map("error")

  device Device @relation(fields: [deviceId], references: [id])
  channelLogs ChannelLog[]
  messageLogs MessageLog[]

  @@index([deviceId])
  @@map("device_polls")
}

model ChannelLog {
  pollId               String  @map("poll_id")
  channelNumber        Int     @map("channel_number")
  channelValue         Int     @map("channel_value")
  isCounting           Boolean @map("is_counting")
  overflowOrLatchValue Boolean @map("overflow_or_latch_value")

  poll DevicePoll @relation(fields: [pollId], references: [id])

  @@id([pollId, channelNumber])
  @@map("channel_logs")
}

model MessageLog {
  id         String   @id @default(uuid()) @map("message_log_id")
  pollId     String   @map("poll_id")
  deviceId   String   @map("device_id")
  occurredAt DateTime @map("occurred_at")
  slot       Int
  channel    Int
  ioType     Int      @map("io_type")
  value      Int

  poll   DevicePoll @relation(fields: [pollId], references: [id])
  device Device     @relation(fields: [deviceId], references: [id])

  @@index([pollId])
  @@index([deviceId, occurredAt])
  @@map("message_logs")
}
